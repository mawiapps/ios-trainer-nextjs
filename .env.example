# Opcional: persistencia en la nube con MongoDB. Opciones:
#  a) MongoDB Atlas (gratis, recomendado para Vercel). Pegá la cadena que te da Atlas, por ejemplo:
# MONGODB_URI=mongodb+srv://usuario:CLAVE@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
#  b) Mongo instalado en este mismo equipo (solo para desarrollo local):
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_URI=

# Nombre de la base (por defecto ios_trainer).
DB_NAME=ios_trainer
